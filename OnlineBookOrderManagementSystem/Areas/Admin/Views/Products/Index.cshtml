@model IEnumerable<OnlineBookOrderManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Index";
}



<link href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator.min.css" rel="stylesheet">


<h1>Index</h1>

<div class="row">
    <div class="col-6">
        <p>
            <a asp-action="Upsert">Create New</a>
        </p>
        <p>
            <a asp-action="DownloadReport" asp-route-UserName="@ViewBag.UserName" target="_blank">Download</a>
        </p>
    </div>
    <div class="col-6">
        <div class="float-end">
            <span>List Price</span>
            <select id="ListPrice">
                <option value="0">All Prices</option>
                <option value="1">100-500</option>
                <option value="2">600-1000</option>
            </select>
            <input id="SearchText" /> <button id="Search" class="border-0 text-bg-info">Search</button>
       </div>
    </div>
</div>

<div id="example-table"></div>
