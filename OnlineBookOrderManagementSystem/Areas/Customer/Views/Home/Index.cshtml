@model IEnumerable<OnlineBookOrderManagementSystem.Models.Product>


@{
    ViewData["Title"] = "Home Page";
}

<div class="row">
@foreach(var item in Model){
  <div class="col-lg-3 col-12 col-md-3 mt-4">
    <div class="card" style="width: 18rem;">
        <img src="@item.ImageUrl" class="card-img-top" alt="...">
        <div class="card-body">
            <h5 class="card-title">@item.Title</h5>
            <p class="card-text">By @item.Author</p>
                    <p class="card-text">List price: <span class="text-decoration-line-through">@item.ListPrice BDT</span></p>
            <p class="card-text">As low as: @item.Price BDT</p>
            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Details</a>
        </div>
    </div>
  </div>
    }
</div>

